# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your chat id (run: python bot.py --get-chat-id, then message the bot)
TELEGRAM_CHAT_ID=123456789
# How often to check the sites, in minutes
CHECK_INTERVAL_MIN=30
# 1 = send only cybersecurity jobs, 0 = all IT jobs (cyber ones are tagged 🔐)
ONLY_CYBER=0
# 1 = send only internships and junior-level titles (Junior, Noorem, Jr., Associate, "Engineer I"...)
ONLY_JUNIOR=0
# With ONLY_JUNIOR=1: also send titles that carry no level at all ("Security Analyst"), 0 = strict
JUNIOR_ALLOW_UNMARKED=0

# --- optional ---
# Max messages per check; anything above that is sent on the next check
MAX_PER_RUN=40
# Forget sent vacancies after this many days (keeps seen.json small)
KEEP_SEEN_DAYS=90
# Tell the chat when a site fails this many checks in a row (0 = never)
SOURCE_ALERT_AFTER=3
# DEBUG shows skipped duplicates, INFO is the default
LOG_LEVEL=INFO
